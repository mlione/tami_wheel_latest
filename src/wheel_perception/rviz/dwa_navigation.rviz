Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: ObstacleFusion Cloud
      Enabled: true
      Topic:
        Value: /zed/point_cloud
      Size (Pixels): 2
    - Class: rviz_default_plugins/Path
      Name: DWA Best Path
      Enabled: true
      Topic:
        Value: /dwa/best_path
      Line Style: Lines
      Line Width: 0.04
      Color: 0; 255; 0
    - Class: rviz_default_plugins/MarkerArray
      Name: DWA Candidates
      Enabled: true
      Topic:
        Value: /dwa/candidate_paths
  Global Options:
    Fixed Frame: base_link
    Background Color: 48; 48; 48
  Name: root
Window Geometry:
  Width: 1280
  Height: 720
