Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: ObstacleFusion Cloud
      Enabled: true
      Topic:
        Value: /zed/point_cloud
      Size (Pixels): 2
    - Class: rviz_default_plugins/PointCloud2
      Name: DWA Effective Obstacles
      Enabled: true
      Topic:
        Value: /dwa/obstacle_cloud
      Size (Pixels): 4
    - Class: rviz_default_plugins/Marker
      Name: Selected Path (Green=Cruise, Blue=DWA)
      Enabled: true
      Topic:
        Value: /dwa/best_path_marker
    - Class: rviz_default_plugins/MarkerArray
      Name: DWA Candidates
      Enabled: true
      Topic:
        Value: /dwa/candidate_paths
  Global Options:
    Fixed Frame: base_link
    Background Color: 48; 48; 48
  Name: root
Window Geometry:
  Width: 1280
  Height: 720
